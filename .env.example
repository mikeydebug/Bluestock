# Bluestock FinTech Internship - Environment Configuration Template
# Copy this file to .env and configure local variables as needed.

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_PATH=mutual_fund_capstone/data/db/mutual_funds.db

# AMFI / MF API Configuration
# Note: api.mfapi.in is an open public endpoint and does not require an API key.
AMFI_BASE_URL=https://api.mfapi.in/mf/
API_TIMEOUT_SECONDS=15
API_MAX_RETRIES=3

# Financial Analytics Assumptions
RISK_FREE_RATE_ANNUAL=0.065
TRADING_DAYS_PER_YEAR=252
HISTORICAL_LOOKBACK_YEARS=3

# Optional Third-Party Market Data APIs (if extended)
MARKET_DATA_API_KEY=
